rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper to check if request is authenticated
    function isAdmin() {
      return request.auth != null;
    }

    match /images/{allPaths=**} {
      // Public visitors need read access to display avatars, project screenshots, and OG banners
      allow read: if true;

      // Only authenticated admins can upload new images or delete existing ones
      allow create, update: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024 // Max 10MB limit
        && request.resource.contentType.matches('image/.*'); // Only image files allowed

      allow delete: if isAdmin();
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
